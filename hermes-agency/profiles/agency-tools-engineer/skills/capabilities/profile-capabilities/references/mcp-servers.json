{
  "mcp_servers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "trust": "untrusted",
      "timeout": 120,
      "connect_timeout": 60,
      "sampling": {
        "enabled": false
      },
      "elicitation": {
        "enabled": false
      },
      "tools": {
        "include": [
          "resolve-library-id",
          "query-docs"
        ],
        "resources": false,
        "prompts": false
      }
    },
    "godot": {
      "command": "node",
      "args": [
        "<godot-mcp-checkout>/build/index.js"
      ],
      "enabled": false,
      "trust": "untrusted",
      "timeout": 120,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "sampling": {
        "enabled": false
      },
      "elicitation": {
        "enabled": false
      },
      "tools": {
        "include": [
          "export_project",
          "get_debug_output",
          "get_godot_version",
          "get_node_insights",
          "get_node_properties",
          "get_project_info",
          "get_scene_insights",
          "get_scene_tree",
          "get_uid",
          "run_project",
          "run_tests",
          "stop_project",
          "validate_script"
        ],
        "resources": false,
        "prompts": false
      }
    }
  }
}
