{
  "mcp_servers": {
    "godot": {
      "command": "node",
      "args": [
        "<godot-mcp-checkout>/build/index.js"
      ],
      "enabled": false,
      "trust": "untrusted",
      "timeout": 120,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "sampling": {
        "enabled": false
      },
      "elicitation": {
        "enabled": false
      },
      "tools": {
        "include": [
          "add_node",
          "capture_screenshot",
          "create_scene",
          "create_tileset",
          "duplicate_node",
          "game_screenshot",
          "game_state",
          "get_debug_output",
          "get_godot_version",
          "get_node_insights",
          "get_node_properties",
          "get_project_info",
          "get_runtime_errors",
          "get_scene_insights",
          "get_scene_tree",
          "get_tile_data",
          "instantiate_scene",
          "run_interactive",
          "save_scene",
          "send_input",
          "send_joypad_button",
          "send_key_sequence",
          "set_cells",
          "set_collision_layer_mask",
          "set_custom_tile_data",
          "set_node_properties",
          "stop_project",
          "validate_scene",
          "wait_for_node",
          "wait_for_signal"
        ],
        "resources": false,
        "prompts": false
      }
    }
  }
}
